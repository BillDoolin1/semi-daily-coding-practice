class Solution(object):
    def reverse(self, x):
        """
        :type x: int
        :rtype: int
        """
        isNeg= False
        if(x<0):
            x=x*-1
            isNeg= True
        x_str = str(x)
        x_len = len(x_str)
        answer=0
        for i in range(x_len):
            answer = answer + (int(x_str[i])*(10**i))
        if isNeg:
            answer= answer*-1
        return answer
