class Solution(object):
    def detectCapitalUse(self, word):
        """
        :type word: str
        :rtype: bool
        """

        if len(word)==1:
            return True  
        if word[1].isupper() and (word[0].isupper()==False):
            return False
        secondLetter = word[1].isupper()
        for i in range(1,len(word)):
            if word[i].isupper() != secondLetter:
                return False
        return True
