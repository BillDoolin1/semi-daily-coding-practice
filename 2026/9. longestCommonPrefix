class Solution(object):
    def longestCommonPrefix(self, strs):
        """
        :type strs: List[str]
        :rtype: str
        """
        shortest_Str = ""
        current_Str = ""
        fits = True
        if len(strs)!=0:
            for i in range(len(strs[0])):
                current_Str=current_Str+strs[0][i]
                for j in range(len(strs)):
                    comparison_str = strs[j][0:i+1:1]
                    if current_Str not in comparison_str:
                        fits=False
                if fits == True:
                    shortest_Str= current_Str
        return shortest_Str
