class Solution(object):
    def isPalindrome(self, x):
        """
        :type x: int
        :rtype: bool
        """
        xstr=str(x)
        halfLen=len(xstr)/2
        result = True
        if halfLen % 1==.5 :
            halfLen-=.5
        for i in range(halfLen):
            if xstr[i]!=xstr[len(xstr)-i-1]:
                result = False
        return result
