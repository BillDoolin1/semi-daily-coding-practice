        :type needle: str
        :rtype: int
        """
        if needle not in haystack:
            return -1   
        current_word = ""    
        for i in range(len(haystack)+1):
            if needle in current_word:
                aaanswer = i-len(needle)
                return aaanswer
            current_word = current_word + haystack[i]
